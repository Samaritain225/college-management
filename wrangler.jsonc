{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wagnon",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Where `vite build` (via @cloudflare/vite-plugin) puts the SPA —
    // without this, `wrangler deploy` has nothing to upload.
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
