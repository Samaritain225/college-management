VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Cloudflare Turnstile site key (public, safe to expose — the secret key never
# goes here; it's configured in Supabase Dashboard > Authentication > Attack
# Protection, where Supabase itself verifies the token server-side).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Public read base for uploaded logos/avatars/receipts (R2 bucket "Public access"
# URL, or a custom domain in front of it). Never put R2 write credentials here —
# those live only in Supabase Edge Function secrets (supabase secrets set ...),
# never in a VITE_* var, since Vite inlines every VITE_* value into the shipped
# JS bundle.
VITE_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev
